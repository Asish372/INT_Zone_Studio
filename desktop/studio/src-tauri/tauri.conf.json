{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "INT Zone Studio",
  "version": "0.1.0-pilot.1",
  "identifier": "com.administrator.desktopstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "INT Zone Studio — Pilot Evaluation Build v1",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "resources": {
      "resources/engine/": "engine/",
      "resources/oda/": "oda/",
      "resources/config.yaml": "config.yaml",
      "resources/PILOT_FEEDBACK.md": "PILOT_FEEDBACK.md",
      "resources/pilot_metrics_template.csv": "pilot_metrics_template.csv"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
